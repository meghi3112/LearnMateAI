# ==============================================================================
# LearnMate AI - Production Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI API Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. MySQL Database Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Standard production variable names:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DATABASE=learnmate_ai

# Backwards-compatible aliases (also supported):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_secure_mysql_password
# DB_NAME=learnmate_ai

# ------------------------------------------------------------------------------
# 3. Flask Security & Session Secret (REQUIRED)
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random string (e.g., using `openssl rand -hex 32`)
FLASK_SECRET_KEY=replace_with_a_secure_random_production_secret_key
# Legacy alias:
# SECRET_KEY=replace_with_a_secure_random_production_secret_key

# ------------------------------------------------------------------------------
# 4. Server & Deployment Options (OPTIONAL)
# ------------------------------------------------------------------------------
PORT=5000
FLASK_DEBUG=false

# Allowed CORS Origins (comma-separated). Use "*" to allow all origins or specify domains:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# Custom persistent storage paths (defaults to local project directories if unset)
# UPLOAD_FOLDER=/var/data/learnmate_ai/uploads
# VECTOR_STORE_DIR=/var/data/learnmate_ai/vectorstores
# MODEL_DIR=/var/data/learnmate_ai/models
